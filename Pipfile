[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
pandas = "*"
networkx = "*"
matplotlib = "*"
cartopy = "*"
certifi = "*"
h3 = "*"
scikit-learn = "*"
global-land-mask = "*"
osmnx = "*"
pyrosm = "*"
pyarrow = "*"
rasterio = "*"
scikit-image = "*"
pillow = "*"
adjusttext = "*"
svgpath2mpl = "*"

[dev-packages]
# Nur für fix_ports_coordinates.py (einmaliges Korrekturskript, siehe
# dort) nötig, nicht für die normale Pipeline - reverse-geocoder zieht
# cykhash mit, eine native Cython-Erweiterung ohne Windows-Wheel für
# viele Python-Versionen, die dort einen funktionierenden MSVC-Build-
# Toolchain braucht. Als optionale Dev-Abhängigkeit blockiert das nicht
# mehr den normalen "pipenv install".
reverse-geocoder = "*"
pycountry = "*"

[requires]
python_version = "3.11"
