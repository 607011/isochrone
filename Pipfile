[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
pandas = "*"
networkx = "*"
matplotlib = "*"
cartopy = "*"
certifi = "*"
h3 = "*"
scikit-learn = "*"
global-land-mask = "*"
osmnx = "*"
pyrosm = "*"
pyarrow = "*"
rasterio = "*"
scikit-image = "*"
pillow = "*"
adjusttext = "*"
svgpath2mpl = "*"
fastapi = "*"
uvicorn = "*"
websockets = "*"

[dev-packages]
# Only needed for fix_ports_coordinates.py (one-time correction script,
# see there), not for the normal pipeline - reverse-geocoder pulls in
# cykhash, a native Cython extension with no Windows wheel for many
# Python versions, requiring a working MSVC build toolchain there. As an
# optional dev dependency this no longer blocks the normal "pipenv install".
reverse-geocoder = "*"
pycountry = "*"

[requires]
python_version = "3.11"
